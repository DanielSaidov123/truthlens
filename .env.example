# PostgreSQL
POSTGRES_USER=truthlens
POSTGRES_PASSWORD=truthlens
POSTGRES_DB=truthlens
POSTGRES_PORT=5433

# Backend
PORT=3000
PORT_HOST=3001
# Inside Docker the host is "postgres". For a backend run on the host use 127.0.0.1:${POSTGRES_PORT}.
DATABASE_URL=postgresql://truthlens:truthlens@postgres:5432/truthlens
# Test database used by integration tests.
TEST_DATABASE_URL=postgresql://truthlens:truthlens@127.0.0.1:5433/truthlens_test

# Storage (Stage 3 only defines the contract; upload API arrives later)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/uploads
S3_ENDPOINT=http://minio:9000
S3_BUCKET=truthlens
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI Service
AI_PROVIDER=mock
# The worker will call this URL from Stage 4 (AI service integration).
AI_SERVICE_URL=http://ai-service:8000

# Worker
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=10
WORKER_MAX_ATTEMPTS=3

# MinIO (optional profile: docker compose --profile s3 up -d)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=truthlens
